# Copy to .env.local and fill in ONE provider key. Keys are server-only; never use NEXT_PUBLIC_ prefixes.
# Automatic priority: NVIDIA > DeepSeek > Anthropic > OpenAI. With no key, the local engine runs.

# NVIDIA hosted API (default model: nvidia/nemotron-3.5-lightning-30b-a3b)
NVIDIA_API_KEY=

# Official DeepSeek API (default model: deepseek-flash)
DEEPSEEK_API_KEY=

# Anthropic (default model: claude-opus-5-5)
ANTHROPIC_API_KEY=

# OpenAI (default model: gpt-5.5)
OPENAI_API_KEY=

# Optional overrides
# PRISON_PROVIDER=nvidia   # nvidia | deepseek | anthropic | openai | local
# PRISON_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b
# NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
# DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
# PRISON_DATA_DIR=./data/prisons

# Optional council: separate NVIDIA models draft, critique and rank prompts.
# Disabled by default. Requires PRISON_PROVIDER=nvidia and the existing NVIDIA key.
# PRISON_COUNCIL_MODE=enabled  # off | enabled
# PRISON_COUNCIL_MODELS=nvidia/nemotron-3-ultra-550b-a55b,nvidia/nemotron-3-super-120b-a12b,openai/gpt-oss-20b,meta/muse-glimmer-30b,meta/llama-3.2-90b-vision-instruct,nvidia/nemotron-3.5-lightning-30b-a3b
# An override must contain 3 to 6 unique publisher/model IDs; availability is checked at runtime.
# Up to 6 stand-ins tried in order when a member fails the 20 s pre-council probe; "none" disables the probe.
# PRISON_COUNCIL_RESERVE_MODELS=poolside/laguna-xs-2.1,nvidia/nemotron-3-nano-omni-30b-a3b-reasoning
# deep (default): investigation round, 3-5 battle rounds, learning and 2-4 consensus rounds. quick: one round.
# PRISON_COUNCIL_DEPTH=deep
